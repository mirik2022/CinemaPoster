    border-radius: 8px;
    padding: 8px 15px;
    font-size: 13px;
    min-width: 120px;
}

QPushButton#filterBtn:hover {
    background: rgba(59, 130, 246, 0.3);
}

QPushButton#filterBtn::menu-indicator {
    width: 0;
    height: 0;
}

/* Меню сортировки */
QMenu#sortMenu {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 10px;
    padding: 5px;
}

QMenu#sortMenu::item {
    color: white;
    padding: 8px 15px;
    border-radius: 5px;
    margin: 2px;
}

QMenu#sortMenu::item:selected {
    background: rgba(139, 92, 246, 0.3);
}

/* Кнопка обновления */
QPushButton#refreshBtn {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    border: 2px solid rgba(16, 185, 129, 0.4);
    border-radius: 8px;
    min-width: 40px;
    min-height: 40px;
    font-size: 16px;
}

QPushButton#refreshBtn:hover {
    background: rgba(16, 185, 129, 0.3);
}

/* Карточки фильмов */
QWidget#movieWidget {
    background: rgba(26, 26, 46, 0.6);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 15px;
    margin: 5px;
}

QWidget#movieWidget:hover {
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-2px);
}

QWidget#movieContent {
    background: transparent;
}

QLabel#movieTitle {
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 5px 0;
}

QLabel#movieGenre {
    color: #8b5cf6;
    font-size: 12px;
    padding: 2px 0;
}

QLabel#movieRating {
    color: #ffd700;
    font-size: 12px;
    padding: 2px 0;
}

QLabel#movieDirector {
    color: #cccccc;
    font-size: 11px;
    padding: 2px 0;
}

QPushButton#detailsBtn {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 5px;
}

QPushButton#detailsBtn:hover {
    background: rgba(139, 92, 246, 0.2);
}

QPushButton#watchBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #8b5cf6, stop:1 #3b82f6);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px;
    font-size: 13px;
    font-weight: bold;
    margin-top: 10px;
}

QPushButton#watchBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #7c3aed, stop:1 #2563eb);
}

/* Состояние пустого списка */
QLabel#emptyState {
    color: #888888;
    font-size: 18px;
    font-style: italic;
    padding: 50px;
    text-align: center;
}

/* Область прокрутки */
QScrollArea#scrollArea {
    border: none;
    background: transparent;
}

QScrollArea#scrollArea QWidget#scrollWidget {
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.05);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(139, 92, 246, 0.5);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(139, 92, 246, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
