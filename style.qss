/* Основные стили */
QMainWindow {
    background: #0a0a1f;
}

#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a0a1f, stop:0.3 #15152b, stop:1 #1a1a2e);
}

/* Верхняя панель */
#headerWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4d8d, stop:0.5 #8b5cf6, stop:1 #3b82f6);
    border-bottom: 3px solid rgba(255, 255, 255, 0.1);
}

#logoLabel {
    color: white;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 2px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

#welcomeLabel {
    color: white;
    font-size: 16px;
    font-weight: 500;
    margin-right: 20px;
}

#balanceLabel {
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 8px 15px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin-right: 15px;
}

#headerBtn {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    margin-left: 10px;
}

#headerBtn:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
}

#headerBtn:pressed {
    background: rgba(255, 255, 255, 0.1);
}

/* Панель фильтров */
#filterWidget {
    background: rgba(26, 26, 46, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
}

#searchContainer {
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(139, 92, 246, 0.3);
    border-radius: 15px;
    padding: 0px;
}

#searchIcon {
    color: #8b5cf6;
    font-size: 18px;
    padding: 0 5px;
}

#searchEdit {
    background: transparent;
    border: none;
    color: white;
    font-size: 14px;
    padding: 12px 0;
    selection-background-color: #8b5cf6;
}

#searchEdit::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

#searchEdit:focus {
    border: none;
    outline: none;
}

/* Комбобоксы */
#filterCombo {
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 20px;
    color: white;
    font-size: 14px;
    min-width: 160px;
}

#filterCombo:hover {
    border-color: rgba(139, 92, 246, 0.5);
    background: rgba(255, 255, 255, 0.12);
}

#filterCombo::drop-down {
    border: none;
    width: 30px;
}

#filterCombo QAbstractItemView {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 10px;
    color: white;
    selection-background-color: #8b5cf6;
    selection-color: white;
    padding: 10px;
}

/* Датапикер */
#dateEdit {
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 20px;
    color: white;
    font-size: 14px;
}

#dateEdit::drop-down {
    image: none;
    border: none;
    width: 30px;
    background: rgba(139, 92, 246, 0.3);
    border-radius: 6px;
}

/* Кнопки фильтров */
#filterBtn {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    border: 2px solid rgba(59, 130, 246, 0.4);
    border-radius: 12px;
    padding: 12px 25px;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
}

#filterBtn:hover {
    background: rgba(59, 130, 246, 0.3);
    border-color: #3b82f6;
    transform: translateY(-2px);
}

#refreshBtn {
    background: rgba(255, 77, 141, 0.2);
    color: #ff4d8d;
    border: 2px solid rgba(255, 77, 141, 0.4);
    border-radius: 12px;
    padding: 12px;
    font-size: 18px;
    min-width: 50px;
}

#refreshBtn:hover {
    background: rgba(255, 77, 141, 0.3);
    border-color: #ff4d8d;
    transform: rotate(90deg);
    transition: transform 0.3s ease;
}

/* Меню сортировки */
#sortMenu {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 12px;
    padding: 10px;
}

#sortMenu::item {
    padding: 12px 25px;
    color: white;
    border-radius: 8px;
    margin: 3px 0;
}

#sortMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4d8d, stop:1 #8b5cf6);
    color: white;
}

/* Карточка фильма */
#movieWidget {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s ease;
}

#movieWidget:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-8px) scale(1.02);
}

#movieImage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1a1a2e, stop:1 #16213e);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

#movieContent {
    background: transparent;
}

#movieTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    line-height: 1.3;
}

#movieGenre {
    color: #8b5cf6;
    font-size: 13px;
    font-weight: 500;
}

#movieRating {
    color: #ffd700;
    font-size: 13px;
    font-weight: 500;
}

#movieDirector {
    color: #3b82f6;
    font-size: 13px;
    font-style: italic;
    margin-bottom: 15px;
}

#detailsBtn {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 8px;
    font-size: 12px;
}

#detailsBtn:hover {
    background: rgba(139, 92, 246, 0.2);
    border-color: #8b5cf6;
}

#watchBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255, 77, 141, 0.2), stop:1 rgba(139, 92, 246, 0.2));
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    margin-top: 10px;
}

#watchBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255, 77, 141, 0.3), stop:1 rgba(139, 92, 246, 0.3));
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

#watchBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255, 77, 141, 0.1), stop:1 rgba(139, 92, 246, 0.1));
}

/* Область прокрутки */
#scrollArea {
    border: none;
    background: transparent;
}

#scrollArea QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.05);
    width: 10px;
    border-radius: 5px;
}

#scrollArea QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4d8d, stop:1 #8b5cf6);
    border-radius: 5px;
    min-height: 30px;
}

#scrollArea QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff2d7a, stop:1 #7c3aed);
}

#scrollArea QScrollBar::add-line:vertical,
#scrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Сообщения */
QMessageBox {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 20px;
}

QMessageBox QLabel {
    color: white;
    font-size: 14px;
}

QMessageBox QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4d8d, stop:1 #8b5cf6);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 25px;
    font-size: 14px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff2d7a, stop:1 #7c3aed);
}

/* Окно ввода */
QInputDialog {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 20px;
}

QInputDialog QLabel {
    color: white;
}

QInputDialog QLineEdit {
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(139, 92, 246, 0.3);
    border-radius: 10px;
    padding: 12px;
    color: white;
}

QInputDialog QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4d8d, stop:1 #8b5cf6);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
}

/* Сетка фильмов */
QGridLayout {
    spacing: 30px;
}

/* Пустое состояние */
QLabel#emptyState {
    color: rgba(255, 255, 255, 0.3);
    font-size: 18px;
    padding: 50px;
    text-align: center;
}
/* Основные стили */
QWidget#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #0a0a1f, stop:1 #15152b);
}

/* Хедер */
QWidget#headerWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #0f0c29, stop:1 #302b63);
    border-bottom: 2px solid rgba(139, 92, 246, 0.3);
}

QLabel#logoLabel {
    color: #8b5cf6;
    font-size: 24px;
    font-weight: bold;
    qproperty-alignment: 'AlignVCenter | AlignLeft';
}

QLabel#welcomeLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: 500;
}

QLabel#balanceLabel {
    background: rgba(139, 92, 246, 0.15);
    color: #8b5cf6;
    font-size: 15px;
    font-weight: bold;
    padding: 8px 15px;
    border-radius: 10px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    min-width: 120px;
    text-align: center;
}

/* Кнопки в хедере */
QPushButton#headerBtn {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 8px 15px;
    font-size: 13px;
    font-weight: 500;
    min-width: 120px;
}

QPushButton#headerBtn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Панель фильтров */
QWidget#filterWidget {
    background: rgba(26, 26, 46, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QWidget#searchContainer {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    min-height: 35px;
}

QLabel#searchIcon {
    color: #8b5cf6;
    font-size: 16px;
    padding: 0 5px;
}

QLineEdit#searchEdit {
    background: transparent;
    border: none;
    color: white;
    font-size: 14px;
    padding: 5px;
}

QLineEdit#searchEdit::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

QComboBox#filterCombo {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: white;
    padding: 5px 15px;
    min-width: 150px;
    font-size: 13px;
}

QComboBox#filterCombo::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox#filterCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8b5cf6;
    width: 0;
    height: 0;
    margin-right: 5px;
}

QComboBox#filterCombo QAbstractItemView {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    color: white;
    selection-background-color: #8b5cf6;
    padding: 5px;
    border-radius: 5px;
}

/* Поле даты */
QDateEdit#dateEdit {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: white;
    padding: 5px 15px;
    min-width: 150px;
    font-size: 13px;
}

QDateEdit#dateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QDateEdit#dateEdit QCalendarWidget {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    color: white;
}

QDateEdit#dateEdit QCalendarWidget QToolButton {
    background: rgba(139, 92, 246, 0.2);
    color: white;
    border-radius: 5px;
}

/* Кнопка сортировки */
QPushButton#filterBtn {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    border: 2px solid rgba(59, 130, 246, 0.4);
    border-radius: 8px;
    padding: 8px 15px;
    font-size: 13px;
    min-width: 120px;
}

QPushButton#filterBtn:hover {
    background: rgba(59, 130, 246, 0.3);
}

QPushButton#filterBtn::menu-indicator {
    width: 0;
    height: 0;
}

/* Меню сортировки */
QMenu#sortMenu {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 10px;
    padding: 5px;
}

QMenu#sortMenu::item {
    color: white;
    padding: 8px 15px;
    border-radius: 5px;
    margin: 2px;
}

QMenu#sortMenu::item:selected {
    background: rgba(139, 92, 246, 0.3);
}

/* Кнопка обновления */
QPushButton#refreshBtn {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    border: 2px solid rgba(16, 185, 129, 0.4);
    border-radius: 8px;
    min-width: 40px;
    min-height: 40px;
    font-size: 16px;
}

QPushButton#refreshBtn:hover {
    background: rgba(16, 185, 129, 0.3);
}

/* Карточки фильмов */
QWidget#movieWidget {
    background: rgba(26, 26, 46, 0.6);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 15px;
    margin: 5px;
}

QWidget#movieWidget:hover {
    border-color: rgba(139, 92, 246, 0.5);
    transform: translateY(-2px);
}

QWidget#movieContent {
    background: transparent;
}

QLabel#movieTitle {
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 5px 0;
}

QLabel#movieGenre {
    color: #8b5cf6;
    font-size: 12px;
    padding: 2px 0;
}

QLabel#movieRating {
    color: #ffd700;
    font-size: 12px;
    padding: 2px 0;
}

QLabel#movieDirector {
    color: #cccccc;
    font-size: 11px;
    padding: 2px 0;
}

QPushButton#detailsBtn {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 5px;
}

QPushButton#detailsBtn:hover {
    background: rgba(139, 92, 246, 0.2);
}

QPushButton#watchBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #8b5cf6, stop:1 #3b82f6);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px;
    font-size: 13px;
    font-weight: bold;
    margin-top: 10px;
}

QPushButton#watchBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #7c3aed, stop:1 #2563eb);
}

/* Состояние пустого списка */
QLabel#emptyState {
    color: #888888;
    font-size: 18px;
    font-style: italic;
    padding: 50px;
    text-align: center;
}

/* Область прокрутки */
QScrollArea#scrollArea {
    border: none;
    background: transparent;
}

QScrollArea#scrollArea QWidget#scrollWidget {
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.05);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(139, 92, 246, 0.5);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(139, 92, 246, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Стиль для сообщений */
QMessageBox {
    background: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 15px;
}

QMessageBox QLabel {
    color: white;
    font-size: 14px;
}

QMessageBox QPushButton {
    background: #00adb5;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
}

QMessageBox QPushButton:hover {
    background: #009ca3;
}

